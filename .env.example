# SentryIP Configuration

# -------------------------------------------------------------
# LLM Provider Key (Set ONE of these to power autonomous AI reasoning)
# -------------------------------------------------------------
# Google Gemini API Key (RECOMMENDED: Single key powers the whole agent!)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OR Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SENTRYIP_MODEL=claude-sonnet-4-5

# -------------------------------------------------------------
# Optional Threat Feeds (Tools skip gracefully if omitted)
# -------------------------------------------------------------
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VT_API_KEY=your_virustotal_api_key_here
IPINFO_TOKEN=your_ipinfo_token_here
OTX_API_KEY=your_alienvault_otx_api_key_here
